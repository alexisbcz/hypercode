<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The release workflow attaches appcast.xml to each release, so the latest one always lists itself. -->
	<key>SUFeedURL</key>
	<string>https://github.com/alexisbcz/hypercode/releases/latest/download/appcast.xml</string>
	<!-- Signs updates; the private half is the SPARKLE_PRIVATE_KEY secret. -->
	<key>SUPublicEDKey</key>
	<string>/mxC7rcrg1rCrhqEIrrQizE3ZXCGwac9QhbrrYnTBac=</string>
	<!-- Check daily without asking first. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
